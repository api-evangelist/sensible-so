      "item": [
        {
          "id": "3bb08d61-384d-485c-96f2-747397008a63",
          "name": "Get CSV extraction",
          "request": {
            "name": "Get CSV extraction",
            "description": {
              "content": "You can use this endpoint to get CSV files from documents, for example, from PDFs. In more detail, this endpoint converts your JSON document extraction to a comma-separated values.\nTo compile multiple documents into one CSV file, specify the IDs of their recent extractions in the request separated by commas, for example,\n`/generate_csv/867514cc-fce7-40eb-8e9d-e6ec48cdac34,5093c65f-05bd-46a3-8df7-da3ed00f6d35`.\nFor the best compiled spreadsheet results, configure your SenseML so that the documents output identically named fields.\nFor more information about the conversion process, see [SenseML to spreadsheet reference](https://docs.sensible.so/docs/excel-reference).\nFor a list of document file types that Sensible can extract data from, see [Supported file types](https://docs.sensible.so/docs/file-types).\nCall this endpoint after an extraction completes. For more information about checking extraction status,\nsee the `GET /documents/{id}` endpoint.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "generate_csv",
                ":ids"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>,<uuid>",
                  "key": "ids",
                  "description": "(Required) Comma-delimited list of unique extraction IDs."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
